{
  "name": "byok-vault",
  "version": "0.2.1",
  "description": "Browser-native BYOK vault with encrypted storage and token circuit breaker.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm run api:check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:check": "node ./scripts/check-api-parity.mjs",
    "pack:check": "node ./scripts/check-pack.mjs && npm run api:check",
    "docs:llm": "node ./scripts/generate-llm-docs.mjs",
    "docs:dev": "npm run docs:llm && vitepress dev docs-site",
    "docs:build": "npm run docs:llm && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "keywords": [
    "byok",
    "vault",
    "browser",
    "aes-gcm",
    "pbkdf2"
  ],
  "author": "Ra <ravicity999@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloareDor/byok-vault.git"
  },
  "homepage": "https://floaredor.github.io/byok-vault/",
  "bugs": {
    "url": "https://github.com/FloareDor/byok-vault/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.19",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  }
}
